@base = http://localhost:8080
@userId = 1
@podcastId = 1
@episodeId = 1
@audioFileId = 1
@slotId = 1

POST {{base}}/api/users
Content-Type: application/json

{
  "name": "Иван",
  "email": "ivan@example.com"
}

### Список users — 200
GET {{base}}/api/users

### Получить users по id — 200
GET {{base}}/api/users/{{userId}}

### Частично обновить users — 200
PATCH {{base}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Иван Комягин"
}

### Создать podcasts — 201 + JSON + Location
POST {{base}}/api/podcasts
Content-Type: application/json

{
  "title": "Мой подкаст",
  "authorId": 1,
  "status": "ACTIVE"
}

### Список podcasts — 200
GET {{base}}/api/podcasts

### Получить podcasts по id — 200
GET {{base}}/api/podcasts/{{podcastId}}

### Частично обновить podcasts — 200
PATCH {{base}}/api/podcasts/{{podcastId}}
Content-Type: application/json

{
  "title": "Новое название"
}

### Создать episodes — 201 + JSON + Location
POST {{base}}/api/episodes
Content-Type: application/json

{
  "podcastId": 1,
  "title": "Первый эпизод",
  "durationSeconds": 1800,
  "publicationState": "DRAFT"
}

### Список episodes — 200
GET {{base}}/api/episodes

### Получить episodes по id — 200
GET {{base}}/api/episodes/{{episodeId}}

### Частично обновить episodes — 200
PATCH {{base}}/api/episodes/{{episodeId}}
Content-Type: application/json

{
  "publicationState": "PUBLISHED"
}

### Создать audio-files — 201 + JSON + Location
POST {{base}}/api/audio-files
Content-Type: application/json

{
  "episodeId": 1,
  "path": "audio/episode-1.mp3",
  "format": "mp3",
  "sizeBytes": 12000000,
  "primary": true
}

### Список audio-files — 200
GET {{base}}/api/audio-files

### Получить audio-files по id — 200
GET {{base}}/api/audio-files/{{audioFileId}}

### Частично обновить audio-files — 200
PATCH {{base}}/api/audio-files/{{audioFileId}}
Content-Type: application/json

{
  "primary": false
}

### Создать publication-slots — 201 + JSON + Location
POST {{base}}/api/publication-slots
Content-Type: application/json

{
  "podcastId": 1,
  "episodeId": 1,
  "scheduledAt": "2026-12-01T15:00:00+03:00",
  "status": "SCHEDULED"
}

### Список publication-slots — 200
GET {{base}}/api/publication-slots

### Получить publication-slots по id — 200
GET {{base}}/api/publication-slots/{{slotId}}

### Частично обновить publication-slots — 200
PATCH {{base}}/api/publication-slots/{{slotId}}
Content-Type: application/json

{
  "status": "CANCELLED"
}

### Удалить publication-slots — 204, пустой ответ
DELETE {{base}}/api/publication-slots/{{slotId}}

### Удалить audio-files — 204, пустой ответ
DELETE {{base}}/api/audio-files/{{audioFileId}}

### Удалить episodes — 204, пустой ответ
DELETE {{base}}/api/episodes/{{episodeId}}

### Удалить podcasts — 204, пустой ответ
DELETE {{base}}/api/podcasts/{{podcastId}}

### Удалить users — 204, пустой ответ
DELETE {{base}}/api/users/{{userId}}
